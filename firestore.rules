rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'chris.bimm@gmail.com',
        'andy.nishimura@gmail.com'
      ];
    }

    match /contracts/{playerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Draft order reveal. draft/meta {revealAt, intervalSec} is public.
    // draft/{slot} ("1".."14") is unreadable until its scheduled reveal moment,
    // enforced server-side: slot 14 opens at revealAt, 13 one interval later, etc.
    match /draft/{slot} {
      function meta() { return get(/databases/$(database)/documents/draft/meta).data; }
      allow read: if slot == 'meta' || isAdmin()
        || request.time >= meta().revealAt + duration.value((14 - int(slot)) * meta().intervalSec, 's');
      allow write: if isAdmin();
    }

    // Beer-league stats: one doc per GM, editable only by that GM's email (or an admin).
    // Keep this map in sync with BEER_LEAGUE in web-app/js/league.js.
    function beerLeagueGM() {
      let owners = {
        'hordoj@gmail.com': 'Hordo',
        'jordanrblack@gmail.com': 'Jordan',
        'daniel.j.gleeson@gmail.com': 'Dan',
        'a.zabrodski@gmail.com': 'Adam',
        'charlie.jemmett@gmail.com': 'Charlie',
        'chris.bimm@gmail.com': 'Bimm',
        'andy.nishimura@gmail.com': 'Andy',
        'trevorregan85@gmail.com': 'Trevor'
      };
      return request.auth != null && request.auth.token.email in owners
        ? owners[request.auth.token.email] : '';
    }
    match /beerleague/{gm} {
      allow read: if true;
      allow write: if isAdmin() || beerLeagueGM() == gm;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
